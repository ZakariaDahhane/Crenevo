<%- include('../partials/header') %>

<section class="section">
    <h1 class="title"><%= title %></h1>
    <div class="room_detail">
        <h2 class="room_name"><%= item.name %></h2>
        <p class="room_description"><%= item.description %></p>
        <p class="room_capacity">Capacité: <%= item.capacity %></p>    
        <% if(userRole === 'manager') { %>
        <a href="/rooms/<%= item.id %>/edit">Modifier la salle</a>
        <form action="/rooms/<%= item.id %>/toggle" method="POST">
        <button type="submit" > <%= item.active ? 'Désactiver la salle' : 'Activer la salle' %></button> 
    </form>
    <% } %>
    </div>
</section>

<%- include('../partials/footer') %>